{
  "manifest_version": 3,
  "name": "Netflix No Autoplay Banner",
  "version": "1.0",
  "description": "Disables the autoplay video banner on Netflix",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://www.netflix.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Netflix No Autoplay"
  }
}
